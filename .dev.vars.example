# Secrets for the Pages Function. Copy to .dev.vars for local work; set the same values
# in the Cloudflare Pages dashboard (Settings > Environment variables) for production.
# This is Cloudflare's always-passes test secret. Replace it with your real secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Kloudcore Website <website@kloudcore.com>
CONTACT_TO_EMAIL=hello@kloudcore.com
